    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.8.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.0",
