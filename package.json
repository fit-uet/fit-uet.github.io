  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:server": "tsx server.ts",
    "dev:worker": "wrangler dev src/worker.ts",
    "build": "vite build && tsx ./scripts/build-server.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy",
    "db:migrate": "tsx scripts/migrate.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:academic": "tsx --test tests/academic/*.test.ts",
