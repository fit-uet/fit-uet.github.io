    "academic:stage:serve": "tsx scripts/serve-academic-staging.ts",
    "test:staging": "tsx --test tests/staging/*.test.ts",
    "academic:reviewers-reset": "tsx scripts/reset-project-reviewers.ts",
    "academic:campaign-migrate": "tsx scripts/migrate-campaigns.ts",
    "academic:correct-roster": "tsx scripts/correct-project-roster.ts",
    "database:failover-d1": "tsx scripts/failover-d1.ts",
    "production:backup": "tsx scripts/backup-production.ts",
    "production:check": "tsx scripts/check-production.ts"
  },
  "dependencies": {
